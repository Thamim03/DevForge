@model DevForge.Application.Common.Models.ChallengeSessionDto
@{
    ViewData["Title"] = ".NET Interview Challenge";
}

<div id="challengeContainer" class="page-container" style="max-width: 760px; margin: 0 auto; padding: 2rem 1rem;">

    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="margin: 0; font-size: 1.4rem;">.NET Interview Challenge</h1>
            @if (!string.IsNullOrEmpty(Model.Category) || !string.IsNullOrEmpty(Model.Difficulty))
            {
                <p style="margin: 0.25rem 0 0 0; color: var(--text-muted); font-size: 0.85rem;">
                    @(Model.Category ?? "All Categories") &bull; @(Model.Difficulty ?? "All Difficulties")
                </p>
            }
        </div>
        <span id="progressLabel" style="font-size: 0.85rem; color: var(--text-muted); background: var(--accent-bg); border: 1px solid var(--border-color); padding: 0.375rem 0.75rem; border-radius: 20px;">
            Question 1 of @Model.TotalQuestions
        </span>
    </div>

    <!-- Progress Bar -->
    <div style="height: 4px; background: var(--border-color); border-radius: 4px; margin-bottom: 2rem; overflow: hidden;">
        <div id="progressBar" style="height: 100%; background: var(--primary-color); border-radius: 4px; width: calc(100% / @Model.TotalQuestions); transition: width 0.3s ease;"></div>
    </div>

    <!-- Question Form -->
    <form asp-action="Submit" asp-controller="Challenge" asp-route-id="@Model.AttemptId" method="post" id="challengeForm">
        @Html.AntiForgeryToken()

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];
            <div class="question-slide tool-card" id="question-@i"
                 style="padding: 2rem; display: @(i == 0 ? "block" : "none");"
                 data-index="@i">

                <p style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--primary-color); margin: 0 0 1rem 0;">
                    Question @(i + 1)
                </p>

                <h2 style="font-size: 1.1rem; font-weight: 600; color: var(--text-heading); margin: 0 0 1.75rem 0; line-height: 1.6;">
                    @question.Text
                </h2>

                <div class="options-list" role="radiogroup" aria-label="Answer options for question @(i+1)">
                    @foreach (var option in question.Options)
                    {
                        <label class="option-label" for="opt-@option.Id">
                            <input type="radio"
                                   id="opt-@option.Id"
                                   name="answers[@question.Id]"
                                   value="@option.Id"
                                   class="option-radio"
                                   onchange="updateOptionStyles(this)" />
                            <span class="option-text">@option.Text</span>
                        </label>
                    }
                </div>
            </div>
        }

        <!-- Navigation -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1.5rem; gap: 1rem;">
            <button type="button" id="prevBtn" onclick="navigate(-1)"
                    class="btn-secondary" disabled
                    aria-label="Previous question" style="min-width: 110px;">
                ← Previous
            </button>

            <button type="button" id="nextBtn" onclick="navigate(1)"
                    class="btn-primary" style="min-width: 110px;"
                    aria-label="Next question">
                Next →
            </button>

            <button type="submit" id="submitBtn"
                    class="btn-primary" style="display: none; min-width: 140px; background: var(--success-color);"
                    aria-label="Submit challenge"
                    onclick="return confirmSubmit()">
                Submit Challenge
            </button>
        </div>
    </form>
</div>

<style>
    .options-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .option-label {
        display: flex;
        align-items: flex-start;
        gap: 0.875rem;
        padding: 0.875rem 1rem;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease;
        background: var(--bg-color);
    }

    .option-label:hover {
        border-color: var(--primary-color);
        background: var(--primary-glow);
    }

    .option-label.selected {
        border-color: var(--primary-color);
        background: var(--accent-bg);
    }

    .option-radio {
        margin-top: 2px;
        accent-color: var(--primary-color);
        flex-shrink: 0;
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .option-text {
        font-size: 0.9rem;
        color: var(--text-main);
        line-height: 1.5;
    }

    @@media (max-width: 480px) {
        #prevBtn, #nextBtn, #submitBtn {
            min-width: auto;
            flex: 1;
        }
    }
</style>

@section Scripts {
<script>
    const totalQuestions = @Model.TotalQuestions;
    let currentIndex = 0;

    function navigate(direction) {
        const slides = document.querySelectorAll('.question-slide');
        slides[currentIndex].style.display = 'none';
        currentIndex += direction;
        slides[currentIndex].style.display = 'block';
        updateNav();
    }

    function updateNav() {
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const submitBtn = document.getElementById('submitBtn');
        const progressBar = document.getElementById('progressBar');
        const progressLabel = document.getElementById('progressLabel');

        prevBtn.disabled = currentIndex === 0;
        const isLast = currentIndex === totalQuestions - 1;
        nextBtn.style.display = isLast ? 'none' : 'inline-flex';
        submitBtn.style.display = isLast ? 'inline-flex' : 'none';

        const progress = ((currentIndex + 1) / totalQuestions) * 100;
        progressBar.style.width = progress + '%';
        progressLabel.textContent = `Question ${currentIndex + 1} of ${totalQuestions}`;
    }

    function updateOptionStyles(radio) {
        const parent = radio.closest('.options-list');
        parent.querySelectorAll('.option-label').forEach(label => label.classList.remove('selected'));
        radio.closest('.option-label').classList.add('selected');
    }

    function confirmSubmit() {
        const allSlides = document.querySelectorAll('.question-slide');
        let unanswered = 0;
        allSlides.forEach(slide => {
            const checked = slide.querySelector('input[type="radio"]:checked');
            if (!checked) unanswered++;
        });
        if (unanswered > 0) {
            return confirm(`You have ${unanswered} unanswered question(s). Submit anyway?`);
        }
        return true;
    }
</script>
}
