@{
    ViewData["Title"] = "Home";
}

<div class="home-layout">
    <!-- Hero Section -->
    <section class="hero-section">
        <h1 class="hero-title">DevForge</h1>
        <p class="hero-subtitle">Developer tools built for developers.</p>
        <p class="hero-support">
            Practical utilities for everyday engineering workflows.
        </p>
    </section>

    <!-- Product Statement Section -->
    <section class="product-statement">
        <div class="statement-card">
            <h2 class="statement-title">Built for everyday engineering</h2>
            <p class="statement-body">
                DevForge brings practical developer utilities and engineering workflows into one focused workspace.
            </p>
        </div>
    </section>

    <!-- System Diagnostics Console -->
    <section class="terminal-panel">
        <div class="terminal-header">
            <div class="terminal-dots">
                <span class="terminal-dot dot-red"></span>
                <span class="terminal-dot dot-yellow"></span>
                <span class="terminal-dot dot-green"></span>
            </div>
            <span class="terminal-title">terminal://devforge-status-client</span>
            <button id="refresh-status-btn" style="background:none;border:none;color:var(--text-muted);cursor:pointer;padding:0;" title="Force status query">
                <!-- Refresh SVG -->
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
            </button>
        </div>
        <div class="terminal-body">
            <div class="terminal-grid">
                <!-- Column 1: Client details -->
                <div>
                    <h4 class="terminal-col-title">Client Details</h4>
                    <div class="terminal-row">
                        <span class="terminal-label">Target Url:</span>
                        <span id="term-target" class="terminal-value">-</span>
                    </div>
                    <div class="terminal-row">
                        <span class="terminal-label">Connection:</span>
                        <span id="term-connection" class="terminal-value">-</span>
                    </div>
                </div>

                <!-- Column 2: Backend status -->
                <div>
                    <h4 class="terminal-col-title">Service State</h4>
                    <div class="terminal-row">
                        <span class="terminal-label">Application:</span>
                        <span id="term-app-name" class="terminal-value" style="color: var(--primary-color);">-</span>
                    </div>
                    <div class="terminal-row">
                        <span class="terminal-label">Version:</span>
                        <span id="term-version" class="terminal-value">-</span>
                    </div>
                    <div class="terminal-row">
                        <span class="terminal-label">Database:</span>
                        <span id="term-db" class="terminal-value">-</span>
                    </div>
                    <div class="terminal-row">
                        <span class="terminal-label">Total Logs:</span>
                        <span id="term-checks" class="terminal-value">-</span>
                    </div>
                </div>
            </div>

            <!-- Terminal log status output -->
            <div id="term-logs" class="terminal-log" style="margin-top: 24px;">
                Connecting to endpoint client...
            </div>
        </div>
    </section>
</div>
