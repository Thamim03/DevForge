@model DevForge.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2 class="auth-title">Create Account</h2>
        <p class="auth-subtitle">Get access to DevForge developer tools</p>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-group">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-input" placeholder="e.g. dev_coder" required />
                <span asp-validation-for="Username" class="text-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" placeholder="e.g. name@domain.com" required />
                <span asp-validation-for="Email" class="text-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-input" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-input" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-error"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Sign Up</button>
        </form>

        <div class="auth-footer">
            Already have an account? <a asp-controller="Account" asp-action="Login" class="auth-link">Sign In</a>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
