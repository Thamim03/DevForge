@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevForge</title>
    <link class="main-css" rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Inject configuration variables directly from appsettings.json into Javascript context
        window.DevForgeConfig = {
            apiUrl: '@Configuration["ApiSettings:BaseUrl"]',
            token: '@(User.Identity?.IsAuthenticated == true ? User.FindFirst("Token")?.Value : "")'
        };
    </script>
</head>
<body>
    <div class="app-container">
        <!-- Minimal Header -->
        <header class="custom-header">
            <div class="header-container">
                <div class="flex items-center">
                    <a class="logo-link" asp-controller="Home" asp-action="Index">
                        <div class="logo-icon-bg">
                            <!-- SVG Terminal Icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                        </div>
                        <span class="logo-text-gradient">DevForge</span>
                    </a>
                </div>

                <nav class="header-nav">
                    <a class="nav-tab-button @(ViewContext.RouteData.Values["action"]?.ToString() == "JsonFormatter" ? "active" : "")" asp-controller="Tools" asp-action="JsonFormatter">JSON Formatter</a>
                    <a class="nav-tab-button @(ViewContext.RouteData.Values["action"]?.ToString() == "JwtInspector" ? "active" : "")" asp-controller="Tools" asp-action="JwtInspector">JWT Inspector</a>
                    <a class="nav-tab-button @(ViewContext.RouteData.Values["action"]?.ToString() == "SqlFormatter" ? "active" : "")" asp-controller="Tools" asp-action="SqlFormatter">SQL Formatter</a>
                    <a class="nav-tab-button @(ViewContext.RouteData.Values["action"]?.ToString() == "ApiPlayground" ? "active" : "")" asp-controller="Tools" asp-action="ApiPlayground">API Playground</a>
                    <a class="nav-tab-button @(ViewContext.RouteData.Values["controller"]?.ToString() == "Challenge" ? "active" : "")" asp-controller="Challenge" asp-action="Index">.NET Challenge</a>
                </nav>

                <div class="header-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="user-info">
                            <span class="user-email">@User.Identity.Name</span>
                            <span class="role-badge @(User.IsInRole("Admin") ? "admin" : "")">
                                @(User.IsInRole("Admin") ? "Admin" : "User")
                            </span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="nav-tab-button btn-logout">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-tab-button @(ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="nav-tab-button btn-register" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main role="main" class="content-main">
            @RenderBody()
        </main>

        <!-- Minimal Footer -->
        <footer class="custom-footer">
            <div class="footer-container">
                <div class="footer-brand">
                    <!-- SVG Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-color);"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                    <span>DevForge Developer Platform</span>
                </div>
                <div class="footer-copy">
                    &copy; @DateTime.UtcNow.Year DevForge
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
