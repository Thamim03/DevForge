@{
    ViewData["Title"] = ".NET Interview Challenge";
    var categories = ViewBag.Categories as IEnumerable<DevForge.Application.Common.Models.CategoryInfo> ?? Enumerable.Empty<DevForge.Application.Common.Models.CategoryInfo>();
}

<div class="page-container" style="max-width: 760px; margin: 0 auto; padding: 2rem 1rem;">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box danger" role="alert" style="margin-bottom: 1.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Page Header -->
    <div style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
            <div style="width: 40px; height: 40px; background: var(--primary-glow); border: 1px solid var(--border-color); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                </svg>
            </div>
            <h1 style="margin: 0; font-size: 1.5rem;">.NET Interview Challenge</h1>
        </div>
        <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem; line-height: 1.6;">
            Test your practical .NET knowledge across C#, ASP.NET Core, EF Core, Web API, SQL Server, and LINQ.
            Questions are selected randomly from the question bank each time.
        </p>
    </div>

    <!-- Challenge Setup Form -->
    <div class="tool-card" style="padding: 2rem;">
        <h2 style="font-size: 1.1rem; margin: 0 0 1.5rem 0; color: var(--text-heading);">Configure Your Challenge</h2>

        <form asp-action="Start" asp-controller="Challenge" method="post">
            @Html.AntiForgeryToken()

            <!-- Category -->
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label for="categorySelect" class="form-label">Category</label>
                <select id="categorySelect" name="Category" class="form-control">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Value">@cat.DisplayName</option>
                    }
                </select>
            </div>

            <!-- Difficulty -->
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label for="difficultySelect" class="form-label">Difficulty</label>
                <select id="difficultySelect" name="Difficulty" class="form-control">
                    <option value="">All Difficulties</option>
                    <option value="1">Easy</option>
                    <option value="2">Medium</option>
                    <option value="3">Hard</option>
                </select>
            </div>

            <!-- Question Count -->
            <div class="form-group" style="margin-bottom: 2rem;">
                <label for="questionCount" class="form-label">Number of Questions</label>
                <select id="questionCount" name="QuestionCount" class="form-control">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                </select>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0.4rem 0 0 0;">
                    Questions are selected randomly each time.
                </p>
            </div>

            <button id="startChallengeBtn" type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 0.875rem 1.5rem; font-size: 1rem;">
                Start Challenge
            </button>
        </form>
    </div>

    <!-- Info Section -->
    <div style="margin-top: 1.5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
        <div class="tool-card" style="padding: 1.25rem; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color); margin-bottom: 0.25rem;">35+</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Questions</div>
        </div>
        <div class="tool-card" style="padding: 1.25rem; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color); margin-bottom: 0.25rem;">6</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Categories</div>
        </div>
        <div class="tool-card" style="padding: 1.25rem; text-align: center;">
            <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color); margin-bottom: 0.25rem;">3</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Difficulty Levels</div>
        </div>
    </div>
</div>

<style>
    .form-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-heading);
        margin-bottom: 0.5rem;
    }
    .form-control {
        width: 100%;
        padding: 0.625rem 0.875rem;
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--text-main);
        font-family: var(--font-sans);
        font-size: 0.9rem;
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        appearance: auto;
    }
    .form-control:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px var(--primary-glow);
    }
</style>
