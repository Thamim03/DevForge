@model DevForge.Application.Common.Models.ChallengeReviewDto
@{
    ViewData["Title"] = "Challenge Review";
}

<div class="page-container" style="max-width: 760px; margin: 0 auto; padding: 2rem 1rem;">

    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="margin: 0; font-size: 1.4rem;">Answer Review</h1>
            <p style="margin: 0.25rem 0 0 0; color: var(--text-muted); font-size: 0.85rem;">
                @Model.CorrectAnswers / @Model.TotalQuestions correct &bull; @((int)Math.Round(Model.Score))%
            </p>
        </div>
        <a href="@Url.Action("Index", "Challenge")" class="btn-secondary" style="text-decoration: none;">
            Try Again
        </a>
    </div>

    <!-- Questions -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var isCorrect = q.IsCorrect;
            var borderColor = isCorrect ? "var(--success-color)" : "var(--danger-color)";
            var iconBg = isCorrect ? "var(--success-bg)" : "var(--danger-bg)";
            var iconColor = isCorrect ? "var(--success-color)" : "var(--danger-color)";

            <div class="tool-card" style="padding: 1.5rem; border-left: 3px solid @borderColor;">
                <!-- Question header -->
                <div style="display: flex; align-items: flex-start; gap: 0.875rem; margin-bottom: 1.25rem;">
                    <div style="width: 32px; height: 32px; background: @iconBg; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">
                        @if (isCorrect)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@iconColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@iconColor" stroke-width="2.5">
                                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                        }
                    </div>
                    <div style="flex: 1;">
                        <p style="margin: 0; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem;">
                            Question @(i + 1)
                        </p>
                        <p style="margin: 0; font-size: 0.95rem; font-weight: 500; color: var(--text-heading); line-height: 1.55;">
                            @q.QuestionText
                        </p>
                    </div>
                </div>

                <!-- Answer comparison -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.25rem;">
                    <div style="background: @iconBg; border: 1px solid @borderColor; border-radius: var(--radius-sm); padding: 0.75rem 1rem;">
                        <p style="margin: 0 0 0.25rem 0; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;">Your Answer</p>
                        <p style="margin: 0; font-size: 0.875rem; color: @iconColor; font-weight: 500;">@q.YourAnswerText</p>
                    </div>
                    @if (!isCorrect)
                    {
                        <div style="background: var(--success-bg); border: 1px solid var(--success-border); border-radius: var(--radius-sm); padding: 0.75rem 1rem;">
                            <p style="margin: 0 0 0.25rem 0; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;">Correct Answer</p>
                            <p style="margin: 0; font-size: 0.875rem; color: var(--success-color); font-weight: 500;">@q.CorrectAnswerText</p>
                        </div>
                    }
                    else
                    {
                        <div style="background: var(--accent-bg); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem; display: flex; align-items: center;">
                            <p style="margin: 0; font-size: 0.875rem; color: var(--text-muted); font-style: italic;">Correctly answered</p>
                        </div>
                    }
                </div>

                <!-- Explanation -->
                <div style="background: var(--accent-bg); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.875rem 1rem;">
                    <p style="margin: 0 0 0.25rem 0; font-size: 0.75rem; font-weight: 600; color: var(--primary-color); text-transform: uppercase; letter-spacing: 0.04em;">Explanation</p>
                    <p style="margin: 0; font-size: 0.875rem; color: var(--text-main); line-height: 1.6;">@q.Explanation</p>
                </div>
            </div>
        }
    </div>

    <!-- Bottom actions -->
    <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
        <a href="@Url.Action("Result", "Challenge", new { id = Model.AttemptId })"
           class="btn-secondary" style="text-decoration: none;">
            ← Back to Result
        </a>
        <a href="@Url.Action("Index", "Challenge")"
           class="btn-primary" style="text-decoration: none;">
            Try Again
        </a>
    </div>
</div>
