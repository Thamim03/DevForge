@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-wrapper">
    <div class="auth-card" style="text-align: center;">
        <div class="error-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--danger-color);"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </div>
        <h2 class="auth-title" style="margin-top: 16px;">Access Denied</h2>
        <p class="auth-subtitle">You do not have the required role permissions to access this page.</p>
        
        <div style="margin-top: 24px;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to Home</a>
        </div>
    </div>
</div>
