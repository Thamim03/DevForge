@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevForge</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Inject configuration variables directly from appsettings.json into Javascript context
        window.DevForgeConfig = {
            apiUrl: '@Configuration["ApiSettings:BaseUrl"]'
        };
    </script>
</head>
<body>
    <div class="app-container">
        <!-- Minimal Product Header -->
        <header class="custom-header">
            <div class="header-container">
                <div class="flex items-center">
                    <a class="logo-link" asp-controller="Home" asp-action="Index">
                        <div class="logo-icon-bg">
                            <!-- Raw SVG Terminal Icon -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                        </div>
                        <span class="logo-text-gradient">DevForge</span>
                    </a>
                </div>

                <!-- Simple Available Product Navigation -->
                <nav class="header-nav">
                    <a class="nav-tab-button active" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="nav-tab-button" href="https://github.com" target="_blank" rel="noopener">GitHub</a>
                </nav>

                <div class="header-actions">
                    <!-- Dynamic API Status Badge -->
                    <div id="status-badge" class="status-badge checking">
                        <span class="dot"></span>
                        <span id="badge-text">Checking API...</span>
                    </div>

                    <!-- Theme Toggle Button -->
                    <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Theme">
                        <!-- Moon SVG -->
                        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                        <!-- Sun SVG -->
                        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- Main Body Content -->
        <main role="main" class="content-main">
            @RenderBody()
        </main>

        <!-- Product Footer -->
        <footer class="custom-footer">
            <div class="footer-container">
                <div class="footer-brand">
                    <!-- SVG Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-color);"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                    <span>DevForge Developer Platform</span>
                </div>
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Index" class="footer-link">Home</a>
                    <a href="https://github.com" target="_blank" rel="noopener" class="footer-link">GitHub</a>
                </div>
                <div class="footer-copy">
                    &copy; @DateTime.UtcNow.Year DevForge. Open source MIT License.
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/js/api.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/system-status.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
