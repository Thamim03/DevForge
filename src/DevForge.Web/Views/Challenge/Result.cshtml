@model DevForge.Application.Common.Models.ChallengeResultDto
@{
    ViewData["Title"] = "Challenge Result";
    var percentage = (int)Math.Round(Model.Score);
    var scoreColor = percentage >= 80 ? "var(--success-color)"
                   : percentage >= 50 ? "var(--warning-color)"
                   : "var(--danger-color)";
    var scoreBg = percentage >= 80 ? "var(--success-bg)"
                : percentage >= 50 ? "var(--warning-bg)"
                : "var(--danger-bg)";
    var scoreBorder = percentage >= 80 ? "var(--success-border)"
                    : percentage >= 50 ? "var(--warning-border)"
                    : "var(--danger-border)";
    var label = percentage >= 80 ? "Great work!" : percentage >= 50 ? "Good effort!" : "Keep practising!";
}

<div class="page-container" style="max-width: 600px; margin: 0 auto; padding: 2rem 1rem;">

    <div style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-size: 1.4rem; margin: 0 0 0.25rem 0;">.NET Interview Challenge</h1>
        <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">Challenge complete</p>
    </div>

    <!-- Score Ring -->
    <div class="tool-card" style="padding: 2.5rem 2rem; text-align: center; margin-bottom: 1.5rem;">
        <div style="width: 120px; height: 120px; border-radius: 50%; background: @scoreBg; border: 3px solid @scoreBorder; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
            <span style="font-size: 2rem; font-weight: 700; color: @scoreColor; line-height: 1;">@percentage%</span>
        </div>
        <p style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600; color: var(--text-heading);">@label</p>
        <p style="margin: 0; color: var(--text-muted); font-size: 0.9rem;">
            @Model.CorrectAnswers out of @Model.TotalQuestions correct
        </p>
    </div>

    <!-- Stats -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
        <div class="tool-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 0.875rem;">
            <div style="width: 36px; height: 36px; background: var(--success-bg); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
            </div>
            <div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--success-color);">@Model.CorrectAnswers</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Correct</div>
            </div>
        </div>
        <div class="tool-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 0.875rem;">
            <div style="width: 36px; height: 36px; background: var(--danger-bg); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--danger-color)" stroke-width="2.5">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </div>
            <div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--danger-color);">@Model.IncorrectAnswers</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Incorrect</div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="@Url.Action("Review", "Challenge", new { id = Model.AttemptId })"
           class="btn-primary" style="flex: 1; justify-content: center; text-align: center; min-width: 140px; text-decoration: none;">
            Review Answers
        </a>
        <a href="@Url.Action("Index", "Challenge")"
           class="btn-secondary" style="flex: 1; justify-content: center; text-align: center; min-width: 140px; text-decoration: none;">
            Try Again
        </a>
    </div>
</div>
